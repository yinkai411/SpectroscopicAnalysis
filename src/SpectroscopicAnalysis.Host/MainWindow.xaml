<Window x:Class="SpectroscopicAnalysis.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpectroscopicAnalysis 上位机" Height="720" Width="1280"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Page}">
    <!-- 三区外壳（界面规范第 5 节弹性布局）：顶栏 56px（白名单固定）+ 侧栏/内容区按比例；全部 Grid 布局 -->
    <Grid>
        <Grid.LayoutTransform>
            <!-- 缩放档位 100/125/150%（界面规范 5.3） -->
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 顶栏（56px 固定白名单） ============ -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌（左） -->
                <TextBlock Grid.Column="0" Text="SpectroscopicAnalysis 上位机" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <!-- 模式按钮组（静态占位，切换交互随功能阶段接入） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModeBtn}" Content="自动" />
                    <Button Style="{StaticResource ModeBtn}" Content="手动" />
                    <Button Style="{StaticResource ModeBtn}" Content="维护" />
                </StackPanel>

                <!-- 右侧状态/操作组（右对齐） -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Brush.Status.Running}" />
                        <TextBlock Text="PLC" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="2026-11-10 09:40" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,16,0"
                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="操作员：张工" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Style="{StaticResource ModeBtn}" Content="100%" Command="{Binding SetScaleCommand}" CommandParameter="1.0" Margin="0,0,4,0" />
                    <Button Style="{StaticResource ModeBtn}" Content="125%" Command="{Binding SetScaleCommand}" CommandParameter="1.25" Margin="0,0,4,0" />
                    <Button Style="{StaticResource ModeBtn}" Content="150%" Command="{Binding SetScaleCommand}" CommandParameter="1.5" Margin="0,0,12,0" />
                    <Button Style="{StaticResource EStopBtn}" Content="急停" ToolTip="急停（需二次确认，功能随 D9 接入）" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 下层：侧栏 + 内容区（比例弹性） ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 侧栏：13* 比例，200–260 区间约束（界面规范 5.1） -->
                <ColumnDefinition Width="13*" MinWidth="200" MaxWidth="260" />
                <ColumnDefinition Width="87*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏：导航（弹性）+ 设备状态固定区（Auto 底部） -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 导航（ICommand 绑定，无 code-behind 逻辑） -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding NavItems}" Margin="8,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Title}"
                                        Margin="0,0,0,4">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
                                            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            <Setter Property="Padding" Value="12,10" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Page}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- 选中项高亮（NavItem.IsSelected 由 MainViewModel 维护） -->
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 设备状态固定区（常驻可见，界面规范 5.1） -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="设备状态（常驻）" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Brush.Status.Running}" />
                                <TextBlock Text="SafetyOK" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Brush.Status.Running}" />
                                <TextBlock Text="RobotReady" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Brush.Status.Running}" />
                                <TextBlock Text="SparkStandReady" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Brush.Status.Running}" />
                                <TextBlock Text="GNR 光谱仪" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Brush.Status.Idle}" />
                                <TextBlock Text="铣床（未接入）" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 内容区：当前页面（DataTemplate 渲染） -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
