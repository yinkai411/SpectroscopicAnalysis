<UserControl x:Class="SpectroscopicAnalysis.Host.Views.SamplesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 样品档案：数据绑定视图（真实 SQLite 数据；状态徽章经 Status DataTrigger 切换颜色） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="样品档案" Style="{StaticResource Text.PageTitle}" Margin="{DynamicResource Spacing.CardGap}" />

            <!-- 类型筛选 -->
            <StackPanel Orientation="Horizontal" Margin="{DynamicResource Spacing.CardGap}">
                <Button Content="全部" Command="{Binding SetFilterCommand}" CommandParameter="All" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="All">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="设置样" Command="{Binding SetFilterCommand}" CommandParameter="SettingUp" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="SettingUp">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="控制样" Command="{Binding SetFilterCommand}" CommandParameter="Control" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="Control">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="类型标准化样" Command="{Binding SetFilterCommand}" CommandParameter="TypeStd" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="TypeStd">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- SCT 样品台账（真实数据） -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <TextBlock Text="SCT 样品台账" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding SctSamples}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" />
                            <DataGridTextColumn Header="合金" Binding="{Binding AlloyType}" />
                            <DataGridTextColumn Header="架位" Binding="{Binding RackPosition}" />
                            <DataGridTextColumn Header="当前/初始厚度 (mm)" Binding="{Binding ThicknessText}" />
                            <DataGridTextColumn Header="最小厚度" Binding="{Binding MinThicknessText}" />
                            <DataGridTextColumn Header="使用次数" Binding="{Binding UsageText}" />
                            <DataGridTemplateColumn Header="状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" Margin="0,2">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Base}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NeedMeasure">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NeedMeasure">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="上次测高" Binding="{Binding LastHeightText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="使用次数达到上限自动标记「需测高」；厚度低于最小厚度自动「禁用」并报警更换" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 生产样品（真实数据；种子库暂无，显示空态） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="生产样品（今日）" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="暂无生产样品记录（生产样品随分析流程入库）" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding HasProduction, Converter={StaticResource BoolToVisibility.Inverse}}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding ProductionSamples}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              Visibility="{Binding HasProduction, Converter={StaticResource BoolToVisibility.Inverse}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" />
                            <DataGridTextColumn Header="合金" Binding="{Binding AlloyType}" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="原始强度与校正后结果双列展示为数据规范硬性要求（随分析流程接入）" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
