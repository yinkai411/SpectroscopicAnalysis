<UserControl x:Class="SpectroscopicAnalysis.Host.Views.SamplesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 样品档案：数据绑定视图（真实 SQLite 数据；状态徽章经 Status DataTrigger 切换颜色） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <DockPanel Margin="{DynamicResource Spacing.CardGap}">
                <TextBlock Text="样品档案" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                <Button Content="＋ 录入新标样" Command="{Binding ToggleRegisterCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Primary}" Foreground="White"
                        FontSize="{DynamicResource FontSize.Caption}" Padding="10,5" Cursor="Hand" />
            </DockPanel>

            <!-- 样品注册表单（入库初始化：当前厚度=初始厚度、使用次数=0、状态=Normal） -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}"
                    Visibility="{Binding IsRegisterOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="录入新标样" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="样品编号*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RegSampleId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="样品名称*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding RegSampleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="样品类型*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SampleTypeOptions}" SelectedItem="{Binding RegSampleType}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="合金类型" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding RegAlloyType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="样品架位置*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RegRackPosition, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="最大使用次数*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding RegMaxUsageCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="初始厚度 (mm)*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RegInitialThickness, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="最小厚度 (mm)*" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding RegMinThickness, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    </Grid>

                    <TextBlock Text="{Binding RegisterError}" TextWrapping="Wrap" Margin="0,4,0,8"
                               Foreground="{DynamicResource Brush.Status.Failed}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegisterError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CancelRegisterCommand}" Margin="0,0,8,0" />
                        <Button Content="确认入库" Command="{Binding RegisterCommand}"
                                Background="{DynamicResource Brush.Primary}" Foreground="White"
                                FontSize="{DynamicResource FontSize.Caption}" Padding="14,6" Cursor="Hand" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 类型筛选 -->
            <StackPanel Orientation="Horizontal" Margin="{DynamicResource Spacing.CardGap}">
                <Button Content="全部" Command="{Binding SetFilterCommand}" CommandParameter="All" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="All">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="设置样" Command="{Binding SetFilterCommand}" CommandParameter="SettingUp" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="SettingUp">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="控制样" Command="{Binding SetFilterCommand}" CommandParameter="Control" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="Control">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="类型标准化样" Command="{Binding SetFilterCommand}" CommandParameter="TypeStd" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterKey}" Value="TypeStd">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- SCT 样品台账（真实数据） -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="SCT 样品台账" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{Binding DeleteError}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Brush.Status.Failed}" TextWrapping="Wrap" MaxWidth="600">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding SctSamples}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" />
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplay}" />
                            <DataGridTextColumn Header="合金" Binding="{Binding AlloyType}" />
                            <DataGridTextColumn Header="架位" Binding="{Binding RackPosition}" />
                            <DataGridTextColumn Header="当前/初始厚度 (mm)" Binding="{Binding ThicknessText}" />
                            <DataGridTextColumn Header="最小厚度" Binding="{Binding MinThicknessText}" />
                            <DataGridTextColumn Header="使用次数" Binding="{Binding UsageText}" />
                            <DataGridTemplateColumn Header="状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" Margin="0,2">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Base}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Running.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NeedMeasure">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Bg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Badge.Failed.Bg}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Running}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NeedMeasure">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Fg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Failed}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="上次测高" Binding="{Binding LastHeightText}" />
                            <!-- 删除（两步确认：Danger 样式 + IsConfirmDelete 切换文案） -->
                            <DataGridTemplateColumn Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button Content="删除" Cursor="Hand" Padding="10,3" FontSize="{DynamicResource FontSize.Caption}"
                                                    Background="Transparent" Foreground="{DynamicResource Brush.Danger}"
                                                    BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                                                    Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="MinWidth" Value="0" />
                                                        <Setter Property="MinHeight" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfirmDelete}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="确认删除？" Cursor="Hand" Padding="10,3" FontSize="{DynamicResource FontSize.Caption}"
                                                    Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource Brush.Danger}" Foreground="White"
                                                    BorderThickness="0" FontWeight="SemiBold">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="MinWidth" Value="0" />
                                                        <Setter Property="MinHeight" Value="0" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfirmDelete}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="使用次数达到上限自动标记「需测高」；厚度低于最小厚度自动「禁用」并报警更换；删除为两步确认（级联删除标准值与控制限，操作日志保留）" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 生产样品（真实数据；种子库暂无，显示空态） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="生产样品（今日）" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="暂无生产样品记录（生产样品随分析流程入库）" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding HasProduction, Converter={StaticResource BoolToVisibility.Inverse}}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding ProductionSamples}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              Visibility="{Binding HasProduction, Converter={StaticResource BoolToVisibility.Inverse}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SampleID" Binding="{Binding SampleId}" FontFamily="Consolas" />
                            <DataGridTextColumn Header="合金" Binding="{Binding AlloyType}" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="原始强度与校正后结果双列展示为数据规范硬性要求（随分析流程接入）" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
