<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 界面设计规范 3.x 全部色值（唯一颜色来源，禁止 XAML/代码硬编码 Hex） -->

    <!-- 3.1 基础色板 -->
    <Color x:Key="Color.Bg.Page">#F5F6F8</Color>
    <Color x:Key="Color.Bg.Card">#FFFFFF</Color>
    <Color x:Key="Color.Border.Default">#E5E7EB</Color>
    <Color x:Key="Color.Primary">#2563EB</Color>
    <Color x:Key="Color.Primary.Hover">#1D4ED8</Color>
    <Color x:Key="Color.Danger">#DC2626</Color>

    <!-- 3.2 文字层级 -->
    <Color x:Key="Color.Text.Primary">#1F2937</Color>
    <Color x:Key="Color.Text.Secondary">#6B7280</Color>
    <Color x:Key="Color.Text.Disabled">#D1D5DB</Color>

    <!-- 3.3 状态色（语义固定，禁止挪用） -->
    <Color x:Key="Color.Status.Running">#16A34A</Color>
    <Color x:Key="Color.Status.Idle">#9CA3AF</Color>
    <Color x:Key="Color.Status.Warning">#F59E0B</Color>
    <Color x:Key="Color.Status.Failed">#DC2626</Color>
    <Color x:Key="Color.Status.Emergency">#991B1B</Color>
    <Color x:Key="Color.Status.Info">#2563EB</Color>

    <!-- 状态徽章浅底（颜色+文字双表达的底色） -->
    <Color x:Key="Color.Badge.Running.Bg">#DCFCE7</Color>
    <Color x:Key="Color.Badge.Idle.Bg">#F3F4F6</Color>
    <Color x:Key="Color.Badge.Warning.Bg">#FEF3C7</Color>
    <Color x:Key="Color.Badge.Warning.Fg">#B45309</Color>
    <Color x:Key="Color.Badge.Failed.Bg">#FEE2E2</Color>
    <Color x:Key="Color.Badge.Failed.Fg">#991B1B</Color>
    <Color x:Key="Color.Badge.Info.Bg">#DBEAFE</Color>
    <Color x:Key="Color.Badge.Info.Fg">#1E40AF</Color>
</ResourceDictionary>
