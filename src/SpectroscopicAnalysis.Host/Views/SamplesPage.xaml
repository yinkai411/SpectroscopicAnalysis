<UserControl x:Class="SpectroscopicAnalysis.Host.Views.SamplesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 样品档案骨架（对照 docs/prototypes/samples.html；静态占位） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="样品档案" Style="{StaticResource Text.PageTitle}" Margin="{DynamicResource Spacing.CardGap}" />

            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <TextBlock Text="SCT 样品台账" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="SampleID / 类型 / 合金 / 架位 / 当前厚度 / 最小厚度 / 使用次数 / 状态 / 上次测高" Style="{StaticResource Table.Header}" TextWrapping="Wrap" />
                    <TextBlock Text="（数据绑定随 D4 SampleManager 接入）" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="生产样品（今日）" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="SampleID / 合金 / 状态 / 分析结果（校正后）/ 原始强度 / 判定 / 归档位" Style="{StaticResource Table.Header}" TextWrapping="Wrap" />
                    <TextBlock Text="（原始与校正数据双列展示为数据规范硬性要求）" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
