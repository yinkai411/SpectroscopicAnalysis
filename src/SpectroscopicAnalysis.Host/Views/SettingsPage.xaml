<UserControl x:Class="SpectroscopicAnalysis.Host.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 设置骨架（对照 docs/prototypes/settings.html；静态占位） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="设置" Style="{StaticResource Text.PageTitle}" Margin="{DynamicResource Spacing.CardGap}" />

            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <TextBlock Text="通信配置（Modbus TCP · 当前）" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="PLC IP / 端口(502) / Unit-ID / 轮询周期 / 心跳间隔 / 超时 / 重试上限 · GNR 地址（TCP 100–140）· 铣床（预留）" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    <TextBlock Text="（OPC UA 为预留升级实现；参数随 D5 通信配置接入）" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <TextBlock Text="全局策略" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="测高触发 · 样品位置一致性校验 · SCT 期间生产队列暂停 · 报警提示音 · 归档标签打印机" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="用户与权限" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="管理员 / 操作员 / 观察员（系数修改、模式切换需管理员）" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
