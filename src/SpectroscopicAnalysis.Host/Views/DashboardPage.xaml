<UserControl x:Class="SpectroscopicAnalysis.Host.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 主控台骨架（对照 docs/prototypes/dashboard.html；静态占位，业务随 D5+/M2 接入） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 标题行 -->
            <DockPanel Margin="{DynamicResource Spacing.CardGap}">
                <TextBlock Text="生产监控" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Running.Bg}" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="● 系统运行中 · Auto" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Status.Running}" />
                </Border>
            </DockPanel>

            <!-- 当前任务卡（步骤进度占位：抓取→铣削→放置→激发→完成） -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="当前任务 #10086" Style="{StaticResource Text.CardTitle}" />
                        <Border Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Running.Bg}" HorizontalAlignment="Right">
                            <TextBlock Text="● 激发中" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Status.Running}" />
                        </Border>
                    </DockPanel>
                    <!-- StepBar 占位（图标白名单：节点 24px） -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                        <StackPanel.Resources>
                            <Style x:Key="StepNode" TargetType="Border">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Style>
                            <Style x:Key="StepLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="StepConn" TargetType="Border">
                                <Setter Property="Height" Value="2" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="8,11,8,0" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Border.Default}" />
                            </Style>
                        </StackPanel.Resources>
                        <StackPanel>
                            <Border Style="{StaticResource StepNode}" Background="{DynamicResource Brush.Status.Running}" BorderBrush="{DynamicResource Brush.Status.Running}">
                                <TextBlock Text="✓" Style="{StaticResource Text.Caption}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="抓取" Style="{StaticResource StepLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource StepConn}" Width="60" Background="{DynamicResource Brush.Status.Running}" />
                        <StackPanel>
                            <Border Style="{StaticResource StepNode}" Background="{DynamicResource Brush.Status.Running}" BorderBrush="{DynamicResource Brush.Status.Running}">
                                <TextBlock Text="✓" Style="{StaticResource Text.Caption}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="铣削（人工跳过）" Style="{StaticResource StepLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource StepConn}" Width="60" Background="{DynamicResource Brush.Status.Running}" />
                        <StackPanel>
                            <Border Style="{StaticResource StepNode}" Background="{DynamicResource Brush.Bg.Card}" BorderBrush="{DynamicResource Brush.Primary}">
                                <TextBlock Text="4" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="放置/激发" Style="{StaticResource StepLabel}" />
                        </StackPanel>
                        <Border Style="{StaticResource StepConn}" Width="60" />
                        <StackPanel>
                            <Border Style="{StaticResource StepNode}" Background="{DynamicResource Brush.Bg.Card}" BorderBrush="{DynamicResource Brush.Text.Disabled}">
                                <TextBlock Text="5" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Disabled}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="完成/归档" Style="{StaticResource StepLabel}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="激发台力控下压完成，等待 GNR RESULT_REQUEST…（占位）" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Border>

            <!-- KPI 四卡（弹性：等比例列） -->
            <Grid Margin="{DynamicResource Spacing.CardGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,6,0" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="128" Style="{StaticResource Text.Display}" Foreground="{DynamicResource Brush.Status.Running}" HorizontalAlignment="Center" />
                        <TextBlock Text="今日已完成" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="6" Style="{StaticResource Text.Display}" HorizontalAlignment="Center" />
                        <TextBlock Text="队列待分析" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="1" Style="{StaticResource Text.Display}" Foreground="{DynamicResource Brush.Status.Warning}" HorizontalAlignment="Center" />
                        <TextBlock Text="未确认报警" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0" Grid.Column="3">
                    <StackPanel>
                        <TextBlock Text="17 / 20" Style="{StaticResource Text.Display}" Foreground="{DynamicResource Brush.Primary}" HorizontalAlignment="Center" />
                        <TextBlock Text="控制样插入倒计时" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 任务队列卡（静态两行示例） -->
            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <TextBlock Text="任务队列" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="60" />
                            <ColumnDefinition Width="*" MinWidth="100" />
                            <ColumnDefinition Width="*" MinWidth="80" />
                            <ColumnDefinition Width="*" MinWidth="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="#" Style="{StaticResource Table.Header}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="SampleID" Style="{StaticResource Table.Header}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="类型" Style="{StaticResource Table.Header}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="状态" Style="{StaticResource Table.Header}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="10086" Style="{StaticResource Text.Mono}" Margin="0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="P-20261110-07" Style="{StaticResource Text.Mono}" Margin="0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="生产样品" Style="{StaticResource Text.Body}" Margin="0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="● 激发中" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Status.Running}" Margin="0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="10089" Style="{StaticResource Text.Mono}" Margin="0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="CTL-002" Style="{StaticResource Text.Mono}" Margin="0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="控制样" Style="{StaticResource Text.Body}" Margin="0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="◆ 定时插入" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Primary}" Margin="0,6" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 报警面板卡（四级静态示例） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="报警面板" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Warning.Bg}" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="12,6">
                        <TextBlock Text="⚠ 5001 控制样 CTL-002 偏差 +2.4σ，接近控制限" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Badge.Warning.Fg}" />
                    </Border>
                    <Border Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Info.Bg}" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="12,6">
                        <TextBlock Text="ℹ 任务 #10085 归档完成（A-12）" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Badge.Info.Fg}" />
                    </Border>
                    <Border Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Failed.Bg}" HorizontalAlignment="Left" Padding="12,6" Opacity="0.55">
                        <TextBlock Text="✖ 1001 机器人抓取失败（已确认）" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Badge.Failed.Fg}" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
