<UserControl x:Class="SpectroscopicAnalysis.Host.Views.AlarmsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 日志报警骨架（对照 docs/prototypes/alarms.html；静态占位） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="日志报警" Style="{StaticResource Text.PageTitle}" Margin="{DynamicResource Spacing.CardGap}" />

            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <TextBlock Text="实时报警（四级）" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Failed.Bg}" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="12,6">
                        <TextBlock Text="⛔ 9001 急停（演示）— 等待故障复位" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Badge.Failed.Fg}" />
                    </Border>
                    <Border Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Warning.Bg}" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="12,6">
                        <TextBlock Text="⚠ 5001 控制样偏差接近控制限" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Badge.Warning.Fg}" />
                    </Border>
                    <Border Style="{StaticResource Badge.Base}" Background="{DynamicResource Brush.Badge.Info.Bg}" HorizontalAlignment="Left" Padding="12,6">
                        <TextBlock Text="ℹ 4001 PLC 心跳瞬时延迟（自动恢复）" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Badge.Info.Fg}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="{DynamicResource Spacing.CardGap}">
                <StackPanel>
                    <TextBlock Text="操作日志" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="时间 / 动作 / 对象 / 上下文 / 起止 / 结果 / 操作者（审计要求全字段）" Style="{StaticResource Table.Header}" TextWrapping="Wrap" />
                    <TextBlock Text="（数据随 D9 错误链路接入）" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="错误码分段统计" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="1xxx 机器人/物料 · 2xxx 激发台 · 3xxx 安全 · 4xxx 通信 · 5xxx 数据业务 · 9xxx 系统" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
